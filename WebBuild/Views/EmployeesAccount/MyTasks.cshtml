@model WebBuild.Models.EmployeesModel.EmployeeTasksPageViewModel
@using WebBuild.Models.Enities
@{
    ViewData["Title"] = "Мои задачи";
    var tasks = Model.Tasks;
    var availableStatuses = Model.AvailableStatuses;
}

<div class="page-container">
    <div class="page-header mb-4 d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Список задач</h2>
    </div>

    <p class="text-muted mb-4">Здесь вы можете видеть все свои задачи и отмечать их выполнение.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
    }
    else if (tasks == null || !tasks.Any())
    {
        <div class="alert alert-info">У вас нет назначенных задач.</div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4 px-3 py-3 bg-white rounded shadow-sm border">
            <div>
                <span class="me-4 fw-bold text-dark">@tasks.Count задач</span>

                @if (tasks.Any(t => t.IsOverdue))
                {
                    <span class="badge bg-danger"><i class="bi bi-exclamation-circle-fill"></i> @tasks.Count(t => t.IsOverdue) просрочка</span>
                }
                else if (Model.CurrentFilter != "Completed")
                {
                    <span class="text-success"><i class="bi bi-check-circle-fill"></i> Просрочек нет</span>
                }
                else
                {
                    <span class="text-muted small">Просмотр выполненных задач</span>
                }
            </div>

            <a asp-action="Index" class="btn btn-outline-secondary mb-3">
                <i class="bi bi-arrow-left"></i> На главную
            </a>
        </div>
        <div class="task-filter-wrapper">
            <nav class="nav nav-pills">
                <a asp-action="MyTasks"
                   asp-route-statusFilter="Active"
                   class="nav-link @(Model.CurrentFilter == "Active" ? "active" : "")">
                    Все активные (кроме «Готово»)
                </a>
                <a asp-action="MyTasks"
                   asp-route-statusFilter="Completed"
                   class="nav-link @(Model.CurrentFilter == "Completed" ? "active" : "")">
                    Только выполненные («Готово»)
                </a>
            </nav>
        </div>

        <div class="custom-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">📋 Список задач</h4>
            </div>
            <div class="card-body" style="padding: 0;">
                <div style="overflow-x: auto;">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Объект</th>
                                <th>Задача</th>
                                <th>Описание задачи</th>
                                <th>Срок</th>
                                <th>Текущий статус</th>
                                <th style="width: 220px;">Действие</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in tasks)
                            {
                                <tr>
                                    <td class="fw-bold text-truncate" style="max-width: 600px;">@task.ObjectAddress</td>
                                    <td class="text-truncate" style="max-width: 400px;">
                                        @(task.Title ?? "Без названия")
                                    </td>

                                    <td class="text-truncate" style="max-width: 500px;">@task.Description</td>
                                    <td>
                                        @if (task.PlannedEndDate.HasValue)
                                        {
                                            <span class="badge @task.BadgeClass">@task.DaysLeftText</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Без срока</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var statusBadge = task.StatusName switch
                                            {
                                                "Готово" => "bg-success",
                                                "В работе" => "bg-primary",
                                                "Требует проверки" => "bg-warning text-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusBadge">@task.StatusName</span>
                                    </td>
                                    <td>
                                        <form asp-action="UpdateTaskStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="taskId" value="@task.Id" />
                                            <select name="newStatusId" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                                @foreach (var status in availableStatuses)
                                                {
                                                    <option value="@status.Id" selected="@(status.Id == task.StatusId)">
                                                        @status.Name
                                                    </option>
                                                }
                                            </select>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
