@model WebBuild.Models.ObjectManager.ContractEditViewModel

@{
    ViewData["Title"] = "Детали договора №" + Model.Id;
}

<div class="container mt-4">
    <a asp-controller="ApplicationManager" asp-action="ObjectManagerApplicationList"
       class="btn btn-outline-secondary mb-3">← К списку заявок</a>
    <a asp-controller="ContractManager" asp-action="EditContract" asp-route-id="@Model.Id"
       class="btn btn-outline-secondary mb-3">← Редактировать</a>

    <div class="card shadow">
        <div class="card-header">
            <h4 class="mb-0">Договор №@Model.Id</h4>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Клиент:</strong> @Model.ClientName</p>
                    <p><strong>Email:</strong> @Model.ClientEmail</p>
                    <p><strong>Шаблон:</strong> @Model.TemplateName</p>
                </div>
                <div class="col-md-6">
                    <p><strong>Статус:</strong> @Model.StatusName</p>
                    <p><strong>Период:</strong>
                        @Model.StartDate.ToString("dd.MM.yyyy") —
                        @Model.EndDate.ToString("dd.MM.yyyy")
                    </p>
                    <p><strong>Подписал:</strong> @Model.SignerName</p>
                </div>
            </div>

            @{
                var services = ViewBag.Services as List<WebBuild.Models.ObjectManager.ServiceLineItem>;
            }
            @if (services != null && services.Any())
            {
                <hr />
                <h5>Услуги по договору</h5>
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Услуга</th>
                            <th>Кол-во</th>
                            <th>Цена</th>
                            <th>Итого</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in services)
                        {
                            <tr>
                                <td>@s.ServiceName</td>
                                <td>@s.Quantity</td>
                                <td>@s.Price.ToString("C")</td>
                                <td>@s.Total.ToString("C")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
