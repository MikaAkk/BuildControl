@model List<WebBuild.Models.Enities.RealEstateObject>

@{
    ViewData["Title"] = "Мои объекты";
    var statuses = ViewBag.Statuses as List<string> ?? new List<string>();
    var currentFilter = ViewBag.StatusFilter as string ?? "Все";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Мои объекты</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← На главную</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            @TempData["Warning"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <form asp-action="MyObjects" method="get" class="d-flex align-items-center gap-2 flex-wrap">
            <label class="form-label mb-0 fw-semibold">Статус:</label>

            <select name="statusFilter" class="form-select form-select-sm" style="width: auto;" onchange="this.form.submit()">
                @if (currentFilter == "Все")
                {
                    <option value="Все" selected>Все статусы</option>
                }
                else
                {
                    <option value="Все">Все статусы</option>
                }

                @foreach (var s in statuses)
                {
                    if (currentFilter == s)
                    {
                        <option value="@s" selected>@s</option>
                    }
                    else
                    {
                        <option value="@s">@s</option>
                    }
                }
            </select>

            @if (currentFilter != "Все")
            {
                <a asp-action="MyObjects" class="btn btn-sm btn-outline-secondary">Сбросить</a>
            }
        </form>
    </div>
    @if (!Model.Any())
    {
        <div class="alert alert-info">
            У вас пока нет объектов@(currentFilter != "Все" ? $" со статусом «{currentFilter}»" : ""). Создайте объект из подписанного договора.
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var obj in Model)
            {
                string statusBadgeClass = obj.CurrentStatus?.Name switch
                {
                    "Архив (завершено)" => "bg-secondary",
                    "Приостановлен" => "bg-warning text-dark",
                    _ => "bg-primary"
                };

                <div class="col-lg-6 col-xl-4">
                    <div class="card shadow-sm h-100">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title text-truncate" style="max-width: 280px;">
                                    🏠 @obj.Address
                                </h5>
                                <span class="badge @statusBadgeClass flex-shrink-0">
                                    @obj.CurrentStatus?.Name
                                </span>
                            </div>

                            <p class="text-muted small mb-2">
                                Клиент: @(obj.Contract?.Client?.PersonData != null
                                                                    ? $"{obj.Contract.Client.PersonData.Surname} {obj.Contract.Client.PersonData.Name}"
                                                                    : "—")
                            </p>

                            <div class="d-flex gap-2 mt-auto">
                                <a asp-action="ObjectDetails"
                                   asp-route-id="@obj.Id"
                                   class="btn btn-primary btn-sm flex-grow-1">
                                    Открыть
                                </a>
                                @if (obj.CurrentStatus?.Name != "Архив (завершено)")
                                {
                                    <a asp-action="AssignEmployees"
                                       asp-route-id="@obj.Id"
                                       class="btn btn-outline-secondary btn-sm">
                                        👥 Сотрудники
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
