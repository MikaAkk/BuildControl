@model WebBuild.Models.Enities.Application
@using WebBuild.Models.Enities

@{
    ViewData["Title"] = $"Заявка #{Model.Id}";
}

<a asp-action="ApplicationsList" class="btn btn-outline-secondary mb-3">&lt;&lt; К списку заявок</a>

<div class="card shadow-sm mb-4">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <strong class="fs-5">Заявка #@Model.Id</strong>
            <span class="badge bg-info text-dark ms-2">@(Model.Status?.Name ?? "Без статуса")</span>
        </div>
        <span class="text-muted">@Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
    </div>
    <div class="card-body">
        <div class="w-100 mb-3 border p-3">
            <label class="text-muted small mb-1">Клиент</label>
            <p class="fw-bold mb-0">
                @(Model.Client?.PersonData?.Surname) @(Model.Client?.PersonData?.Name)
            </p>
        </div>

        <div class="w-100 mb-3 border p-3">
            <label class="text-muted small mb-1">Руководитель</label>
            <p class="fw-bold mb-0">
                @if (Model.AssignedManager != null)
                {
                    @(Model.AssignedManager.PersonData?.Surname) @(Model.AssignedManager.PersonData?.Name)
                }
                else
                {
                    <span class="text-muted">Не назначен</span>
                }
            </p>
        </div>

        <div class="w-100 mb-3 border p-3">
            <label class="text-muted small mb-1">Email клиента</label>
            <p class="fw-bold mb-0">@(Model.Client?.PersonData?.Email ?? "-")</p>
        </div>
        @if (Model.ApplicationServices != null && Model.ApplicationServices.Any())
        {
            <hr>
            <h5>Услуги</h5>
            <div class="w-100 border p-3">
                <table class="table table-sm mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Услуга</th>
                            <th>Кол-во</th>
                            <th>Цена</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.ApplicationServices)
                        {
                            <tr>
                                <td>@(s.Service?.Name ?? "-")</td>
                                <td>@s.Quantity</td>
                                <td>@s.TotalPrice</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h5 class="mb-0">Лента изменений статуса</h5>
    </div>
    <div class="card-body">
        @await Html.PartialAsync("_ApplicationHistory", ViewBag.StatusHistory as IEnumerable<ApplicationStatusHistory>)
    </div>
</div>