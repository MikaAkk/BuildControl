@model IEnumerable<WebBuild.Models.Enities.Client>
@{
    ViewData["Title"] = "Список клиентов";

    string searchTerm = (string)(ViewBag.SearchTerm ?? "");
    bool showActiveOnly = (bool?)(ViewBag.ShowActiveOnly ?? false) == true;

    bool isAllSelected = !showActiveOnly;
    bool isActiveOnlySelected = showActiveOnly;
    bool hasFilters = !string.IsNullOrEmpty(searchTerm) || showActiveOnly;
}

<div class="container-fluid">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="role">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary mb-3">&lt;&lt; На главную админки</a>
    <h2 class="mb-4">Список клиентов</h2>

    <div class="w-100 mb-4 shadow-sm">
        <div class="card">
            <div class="card-header">
                <strong>Фильтр клиентов</strong>
            </div>
            <div class="card-body p-3">
                <form asp-action="ClientIndex" method="get" class="row g-3 align-items-end">
                    <div class="col-md-6">
                        <label class="form-label">Поиск (ФИО, телефон)</label>
                        <input type="text" name="search" class="form-control" placeholder="Иванов, +7999..." value="@searchTerm" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">Заявки</label>
                        <select name="hasActiveApplications" class="form-select" onchange="this.form.submit()">
                            <option value="">Все клиенты</option>
                            <option value="true">Только с активными заявками</option>
                        </select>
                    </div>

                    <div class="col-md-2 d-flex justify-content-end">
                        @if (hasFilters)
                        {
                            <a asp-action="ClientIndex" class="btn btn-outline-secondary">Сбросить</a>
                        }
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info w-100">Клиентов по выбранным фильтрам не найдено.</div>
    }
    else
    {
        <div class="w-100">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>ФИО</th>
                        <th>Телефон</th>
                        <th>Email</th>
                        <th>Компания</th>
                        <th>Заявок всего</th>
                        <th>Активных</th>
                        <th>Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var client in Model)
                    {
                        var excludedStatusNames = new[] { "Отклонена", "Выполнена" };
                        var activeApps = client.Applications.Count(a => !excludedStatusNames.Contains(a.Status.Name));
                        var totalApps = client.Applications.Count;

                        <tr>
                            <td>@client.Id</td>
                            <td>
                                <strong>@client.PersonData.Surname @client.PersonData.Name</strong>
                                @if (client.PersonData.Patronymic != null)
                                {
                                    <br><small class="text-muted">@client.PersonData.Patronymic</small>
                                }
                            </td>
                            <td>@(client.PersonData.PhoneNumber?.Phone ?? "-")</td>
                            <td>@(client.PersonData.Email ?? "-")</td>
                            <td>@(client.Contragent?.Name ?? "Частное лицо")</td>
                            <td>@totalApps</td>
                            <td>
                                @if (activeApps > 0)
                                {
                                    <span class="badge bg-warning text-dark">@activeApps</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="Client" asp-action="Edit" asp-route-id="@client.Id" class="btn btn-sm btn-primary">Редактировать</a>
                                <form asp-controller="Client" asp-action="Delete" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@client.Id" />
                                    <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Удалить клиента @(client.PersonData.Surname) @(client.PersonData.Name)?')">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
