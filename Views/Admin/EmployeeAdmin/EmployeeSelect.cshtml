@model IEnumerable<WebBuild.Models.Enities.Employee>
@{
    ViewData["Title"] = "Сотрудники";
}
<link href="/css/style.css" rel="stylesheet" />

<div class="container-fluid">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["WarningMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary mb-3">&lt;&lt; На главную админки</a>
    <a asp-controller="EditCreate" asp-action="Create" class="btn btn-success mb-3">
        ➕ Добавить нового сотрудника
    </a>

    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <strong>Фильтр сотрудников</strong>
        </div>
        <div class="card-body p-3">
            <form asp-action="EditIndex" method="get" class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">Статус</label>
                    <select name="statusFilter" class="form-select" onchange="this.form.submit()">
                        <option value="0" selected="@(ViewBag.SelectedStatus == 0)">Все сотрудники</option>
                        <option value="1" selected="@(ViewBag.SelectedStatus == 1)">Только активные</option>
                        <option value="2" selected="@(ViewBag.SelectedStatus == 2)">Только удалённые</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Должность</label>
                    <select name="positionId" class="form-select" onchange="this.form.submit()">
                        <option value="0">Все должности</option>
                        @foreach (var pos in ViewBag.Positions as System.Collections.Generic.IEnumerable<WebBuild.Models.Enities.Position>)
                        {
                            <option value="@pos.Id" selected="@(ViewBag.SelectedPosition == pos.Id)">
                                @pos.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Роль</label>
                    <select name="roleId" class="form-select" onchange="this.form.submit()">
                        <option value="0">Все роли</option>
                        @foreach (var role in ViewBag.Roles as System.Collections.Generic.IEnumerable<WebBuild.Models.Enities.Role>)
                        {
                            <option value="@role.Id" selected="@(ViewBag.SelectedRole == role.Id)">
                                @role.Name
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-3 d-flex justify-content-end">
                    <a asp-action="EditIndex" class="btn btn-outline-secondary">Сбросить фильтр</a>
                </div>
            </form>
        </div>
    </div>

    <h2 class="mb-4">Список сотрудников</h2>
    <div class="table-responsive">
        <table class="table table-striped table-hover w-100">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>ФИО</th>
                    <th>Должность / Роль</th>
                    <th>Телефон</th>
                    <th>Email</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-4 text-muted">Сотрудников не найдено</td>
                    </tr>
                }
                else
                {
                    @foreach (var emp in Model)
                    {
                        var rowClass = emp.IsDeleted ? "table-secondary text-muted" : "";

                        <tr class="@rowClass">
                            <td>@emp.Id</td>
                            <td>
                                <strong>@emp.PersonData.Surname @emp.PersonData.Name</strong>
                                @if (emp.IsDeleted)
                                {
                                    <br>
                                    <small class="text-danger fst-italic">Помечен на удаление</small>
                                }
                            </td>
                            <td>
                                @(emp.Position?.Name ?? "-") / @(emp.Role?.Name ?? "-")
                            </td>
                            <td>@(emp.PersonData.PhoneNumber?.Phone ?? "-")</td>
                            <td>@(emp.PersonData.Email ?? "-")</td>
                            <td>
                                @if (emp.IsDeleted)
                                {
                                    <span class="badge bg-secondary">Удалён</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">Активен</span>
                                }
                            </td>
                            <td>
                                @if (!emp.IsDeleted)
                                {
                                    <a asp-controller="EditCreate"
                                       asp-action="Edit"
                                       asp-route-id="@emp.Id"
                                       class="btn btn-sm btn-primary">
                                        Редактировать
                                    </a>

                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            onclick="openDeleteModal(@emp.Id, '@emp.PersonData.Surname @emp.PersonData.Name')">
                                        Удалить
                                    </button>
                                }
                                else
                                {
                                    <form asp-controller="EditCreate"
                                          asp-action="Restore"
                                          method="post"
                                          class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@emp.Id" />
                                        <button type="submit" class="btn btn-sm btn-warning">
                                            Восстановить
                                        </button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div> 

<div id="deleteModal" class="modal-overlay" style="display: none;">
    <div class="modal-dialog-custom">
        <div class="modal-content-custom">
            <div class="modal-header-custom">
                <h5>Подтверждение удаления</h5>
                <button type="button" class="btn-close-custom" onclick="closeDeleteModal()">✕</button>
            </div>
            <div class="modal-body-custom">
                Вы уверены, что хотите пометить на удаление сотрудника: <b id="deleteName"></b>?
                <br><br>
                Все заявки этого менеджера будут автоматически переназначены на другого активного сотрудника.
            </div>
            <div class="modal-footer-custom">
                <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">Отмена</button>
                <form id="deleteForm" method="post" asp-controller="EditCreate" asp-action="Delete" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <button type="submit" class="btn btn-danger">Подтвердить удаление</button>
                </form>
            </div>
        </div>
    </div>
</div>
<script src="~/js/admin/employeeAdmin/EmployeeSelect.js" asp-append-version="true"></script>