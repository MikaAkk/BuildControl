@model WebBuild.Models.Enities.WorkerService
@{
    var isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Редактирование услуги" : "Создание услуги";
}

<div class="container-fluid">
    <a asp-action="ServiceIndex" class="btn btn-outline-secondary mb-3">&lt;&lt; К списку услуг</a>
    <h2 class="mb-4">@ViewData["Title"]</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" class="w-100">
                @Html.AntiForgeryToken()

                @if (isEdit)
                {
                    <input type="hidden" name="Id" value="@Model.Id" />
                }

                <div class="mb-3 w-100">
                    <label class="form-label">Название услуги *</label>
                    <input asp-for="Name" class="form-control w-100" placeholder="Например: Выезд замерщика" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3 w-100">
                    <label class="form-label">Ед. изм.</label>
                    <input asp-for="Unit" class="form-control w-100" placeholder="шт, час, м²" />
                    <span asp-validation-for="Unit" class="text-danger"></span>
                </div>

                <div class="mb-3 w-100">
                    <label class="form-label">Базовая цена (руб.) *</label>
                    <input asp-for="BasePrice" class="form-control w-100" type="number" step="0.01" min="0" required />
                    <span asp-validation-for="BasePrice" class="text-danger"></span>
                </div>

                <div class="mb-3 w-100">
                    <label class="form-label">Статус</label>
                    <select asp-for="IsActive" class="form-select w-100">
                        <option value="true">Активна (видна в заявках)</option>
                        <option value="false">Неактивна (архив)</option>
                    </select>
                </div>

                <div class="mb-3 w-100">
                    <label class="form-label">Описание</label>
                    <textarea asp-for="Description" class="form-control w-100" rows="4"
                              placeholder="Детали услуги, условия, ограничения..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <hr class="my-4">

                <button type="submit" class="btn btn-primary w-100">@(isEdit ? "Сохранить изменения" : "Создать услугу")</button>
                <a asp-action="ServiceIndex" class="btn btn-outline-secondary w-100 mt-2">Отмена</a>

            </form>
        </div>
    </div>
</div>