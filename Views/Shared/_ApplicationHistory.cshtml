@model IEnumerable<WebBuild.Models.Enities.ApplicationStatusHistory>
@using WebBuild.Models.Enities

@if (Model == null || !Model.Any())
{
    <div class="text-muted small">История изменений пуста</div>
}
else
{
    <ul class="list-group list-group-flush">
        @foreach (var item in Model.OrderByDescending(h => h.ChangedAt))
        {
            <li class="list-group-item d-flex align-items-start gap-3">
                <div class="badge bg-light text-dark border pt-2" style="min-width: 110px; text-align: center;">
                    @item.ChangedAt.ToString("dd.MM.yyyy HH:mm")
                </div>

                <div>
                    <div class="fw-bold">
                        @(item.ChangedByEmployee?.PersonData?.Surname ?? "")
                        @(item.ChangedByEmployee?.PersonData?.Name ?? "")
                    </div>

                    <small class="text-muted">
                        Сменил статус на <strong>"@(item.Status?.Name ?? "—")"</strong>
                        @if (!string.IsNullOrEmpty(item.ChangeComment))
                        {
                            <br>
                            <span>Комментарий: "@item.ChangeComment"</span>
                        }
                    </small>
                </div>
            </li>
        }
    </ul>
}

