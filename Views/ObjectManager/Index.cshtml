@using WebBuild.Models.Enities
@{
    ViewData["Title"] = "Панель руководителя";
}
<link href="/css/style.css" rel="stylesheet" />

<div class="page-container">
    <div class="page-header mb-4 d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Панель руководителя</h2>
        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-logout">
                <svg class="bi" width="16" height="16">
                    <use xlink:href="/bootstrap-icons.svg#box-arrow-right"></use>
                </svg>
                Выйти
            </button>
        </form>
    </div>

    <p class="text-muted mb-4">Здесь вы можете контролировать объекты, задачи и заявки.</p>
    <div class="row mb-4 g-3 justify-content-center">
        <div class="col-md-3">
            <div class="card stat-card stat-blue h-100 d-flex">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="stat-title">Всего объектов</h5>
                        <p class="stat-number mb-0">@(ViewBag.TotalObjects ?? 0)</p>
                    </div>
                    <small class="stat-desc">Общее количество объектов в системе</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card stat-amber h-100 d-flex">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="stat-title">Активных объектов</h5>
                        <p class="stat-number mb-0">@(ViewBag.ActiveObjects ?? 0)</p>
                    </div>
                    <small class="stat-desc">В работе, не закрыты и не сняты с учёта</small>
                </div>
            </div>
        </div>

        @{
            int totalTasks = (int)(ViewBag.TotalTasks ?? 1);
            int inProgressTasks = (int)(ViewBag.InProgressTasks ?? 0);
            int percent = totalTasks > 0 ? (inProgressTasks * 100 / totalTasks) : 0;
            string barColor = percent > 70 ? "bg-danger" : (percent > 40 ? "bg-warning" : "bg-success");
        }
        <div class="col-md-3">
            <div class="card stat-card stat-cyan h-100 d-flex">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h5 class="stat-title">Задач в работе</h5>
                        <p class="stat-number mb-0">@inProgressTasks из @totalTasks</p>
                        <small class="text-muted mt-1 d-block">Загрузка отдела: @percent%</small>
                    </div>
                    <div class="progress mt-2" style="height: 6px;">
                        <div class="progress-bar @barColor" role="progressbar" style="width: @percent%"
                             aria-valuenow="@percent" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card stat-card stat-red h-100 d-flex position-relative overflow-hidden">
                <div class="card-body d-flex flex-column justify-content-between position-relative">
                    <div>
                        <h5 class="stat-title">Просроченные задачи</h5>
                        @if ((int?)ViewBag.OverdueTasks > 0)
                        {
                            <p class="stat-number mb-0 text-danger">@ViewBag.OverdueTasks</p>
                            <small class="stat-desc text-danger">Требуют срочного внимания</small>
                        }
                        else
                        {
                            <p class="stat-number mb-0 text-success">@ViewBag.OverdueTasks</p>
                            <small class="stat-desc text-success">Всё в порядке!</small>
                        }
                    </div>
                    <button type="button" data-bs-toggle="modal" data-bs-target="#overdueModal"
                            class="btn btn-sm btn-outline-danger rounded-pill shadow-sm">
                        Проверить
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-12">
            <div class="card h-100 d-flex flex-column">
                <div class="card-header">
                    <h4>Быстрые действия</h4>
                </div>
                <div class="card-body flex-fill d-flex flex-column">
                    <div class="d-grid gap-2 flex-fill">
                        <a asp-controller="ApplicationManager" asp-action="ObjectManagerApplicationList" class="btn btn-action">
                            📋 Заявки
                        </a>
                        <a asp-controller="ObjectManager" asp-action="MyObjects" class="btn btn-action">
                            🏠 Мои объекты
                        </a>
                        <a asp-controller="ContractManager" asp-action="ContractList" class="btn btn-action">
                            💰 Договоры
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="overdueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">🔥 Просроченные задачи (@ViewBag.OverdueTasks)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (ViewBag.TopOverdueTasks != null && ((System.Collections.IEnumerable)ViewBag.TopOverdueTasks).Cast<object>().Any())
                {
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Объект</th>
                                <th>Задача</th>
                                <th>Срок</th>
                                <th>Исполнитель</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in (IEnumerable<dynamic>)ViewBag.TopOverdueTasks)
                            {
                                int daysOverdue = (DateTime.UtcNow - task.DueDate).Days;
                                <tr>
                                    <td class="fw-bold">@task.ObjectAddress</td>
                                    <td>@task.TaskDescription</td>
                                    <td>
                                        <span class="badge bg-danger">
                                            -@daysOverdue дн.
                                        </span>
                                    </td>
                                    <td>@task.EmployeeName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">На данный момент нет просроченных задач.</p>
                }
            </div>
        </div>
    </div>
</div>