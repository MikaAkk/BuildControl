@model WebBuild.Models.ObjectManager.CreateObjectViewModel

@{
    ViewData["Title"] = "Создание объекта";
}

<div class="container mt-4">
    <a asp-controller="ContractManager" asp-action="EditContract" asp-route-id="@Model.ContractId"
       class="btn btn-outline-secondary mb-3">← Назад к договору</a>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow">
        <div class="card-header">
            <h4 class="mb-0">🏠 Создание объекта строительства</h4>
        </div>
        <div class="card-body">
            <div class="alert alert-info">
                <strong>Клиент:</strong> @Model.ClientName<br />
                <strong>Шаблон договора:</strong> @Model.ContractTemplateName<br />
                <strong>Договор №:</strong> @Model.ContractId
            </div>

            <form asp-controller="ObjectManager" asp-action="CreateObject" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ContractId" value="@Model.ContractId" />
                <input type="hidden" name="ClientName" value="@Model.ClientName" />
                <input type="hidden" name="ContractTemplateName" value="@Model.ContractTemplateName" />

                <div class="mb-3">
                    <label class="form-label">Адрес объекта <span class="text-danger">*</span></label>
                    <input type="text" name="Address" value="@Model.Address"
                           class="form-control" placeholder="Например: г. Донецк, ул. Ленина, д. 1"
                           required />
                    @if (ViewData.ModelState["Address"]?.Errors.Count > 0)
                    {
                        <div class="text-danger small">@ViewData.ModelState["Address"].Errors[0].ErrorMessage</div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label">Описание проекта</label>
                    <textarea name="ProjectDescription" class="form-control" rows="4"
                              placeholder="Например: Двухэтажный жилой дом, площадь 120 м²">@Model.ProjectDescription</textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Начальный статус</label>
                    <select name="StatusId" class="form-select" required>
                        @foreach (var s in Model.AvailableStatuses)
                        {
                            <option value="@s.Id" selected="@(Model.StatusId == s.Id)">@s.Name</option>
                        }
                    </select>
                </div>

                <button type="submit" class="btn btn-success">🏠 Создать объект</button>
                <a asp-controller="ContractManager" asp-action="EditContract" asp-route-id="@Model.ContractId"
                   class="btn btn-outline-secondary">Отмена</a>
            </form>
        </div>
    </div>
</div>
