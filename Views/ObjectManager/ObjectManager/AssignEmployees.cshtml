@model WebBuild.Models.ObjectManager.AssignEmployeesViewModel

@{
    ViewData["Title"] = "Назначение сотрудников";
}

<div class="container mt-4">
    <a asp-action="ObjectDetails" asp-route-id="@Model.ObjectId" class="btn btn-outline-secondary mb-3">← Назад к объекту</a>

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">👷 Назначение сотрудников на объект</h4>
        </div>
        <div class="card-body">
            <p class="lead">Объект: <strong>@Model.ObjectAddress</strong></p>

            @if (!Model.AvailableEmployees.Any())
            {
                <div class="alert alert-warning">
                    Нет доступных сотрудников с ролью «Сотрудник».
                    Обратитесь к администратору для добавления новых сотрудников.
                </div>
            }
            else
            {
                <form asp-controller="ObjectManager" asp-action="AssignEmployees" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ObjectId" value="@Model.ObjectId" />
                    <input type="hidden" name="ObjectAddress" value="@Model.ObjectAddress" />

                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th style="width: 50px;">Назначить</th>
                                <th>Сотрудник</th>
                                <th>Должность</th>
                                <th>Статус</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var emp in Model.AvailableEmployees)
                            {
                                var isAssigned = Model.AlreadyAssignedIds.Contains(emp.Id);
                                <tr class="@(isAssigned ? "table-success" : "")">
                                    <td>
                                        <input type="checkbox" name="SelectedEmployeeIds" value="@emp.Id"
                                               class="form-check-input emp-checkbox"
                                               id="emp-@emp.Id"
                                        @(isAssigned ? "checked" : "") />
                                    </td>
                                    <td>
                                        <label for="emp-@emp.Id" class="form-label fw-bold mb-0">@emp.FullName</label>
                                    </td>
                                    <td>@emp.Position</td>
                                    <td>
                                        @if (isAssigned)
                                        {
                                            <span class="badge bg-success">Назначен</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Свободен</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <button type="submit" class="btn btn-success">💾 Сохранить назначения</button>
                    <a asp-action="ObjectDetails" asp-route-id="@Model.ObjectId" class="btn btn-outline-secondary">Отмена</a>
                </form>
            }
        </div>
    </div>
</div>


<script src="~/js/objectManager/objectManager/AssignEmployees.js" asp-append-version="true"></script>
