@model List<WebBuild.Models.ObjectManager.ApplicationViewManager>
@{
    ViewData["Title"] = "Мои заявки";
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 20;
    int totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : (ViewBag.TotalCount != null ? (int)ViewBag.TotalCount : Model.Count);
    string searchTerm = ViewBag.SearchTerm?.ToString() ?? "";
    long selectedStatusId = ViewBag.SelectedStatusId != null ? (long)ViewBag.SelectedStatusId : 0;
}
<link href="/css/style.css" rel="stylesheet" />
<div class="page-container">
    <div class="header mb-4 d-flex justify-content-between align-items-center">
        <h2>Мои заявки (@ViewBag.TotalCount)</h2>
        <a asp-action="Index" asp-controller="ObjectManager" class="btn btn-outline-secondary">&lt;&lt; На главную</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="custom-card mb-4">
        <div class="card-header">Фильтр</div>
        <div class="card-body">
            <form method="get" asp-action="ObjectManagerApplicationList" asp-controller="ApplicationManager" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Поиск (ФИО, телефон, ID)</label>
                    <input type="text" name="search" class="form-control" placeholder="Иванов, +7999..." value="@searchTerm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Статус заявки</label>
                    <select name="statusId" class="form-select">
                        <option value="0" selected="@(selectedStatusId == 0)">-- Все статусы --</option>
                        @if (ViewBag.Statuses != null)
                        {
                            @foreach (var s in (IEnumerable<WebBuild.Models.Enities.ApplicationStatus>)ViewBag.Statuses)
                            {
                                <option value="@s.Id" selected="@(s.Id == selectedStatusId)">@s.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2 mt-2">
                    <button type="submit" class="btn btn-primary">Фильтровать</button>
                    <a href="@Url.Action("ObjectManagerApplicationList", "ApplicationManager")" class="btn btn-outline-secondary">Сброс</a>
                </div>
            </form>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Заявок не найдено.</div>
    }
    else
    {
        <div class="custom-card">
            <div class="card-header mb-3">Заявки на согласование</div>
            <div style="overflow-x: auto;">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Дата</th>
                            <th>Клиент</th>
                            <th>Услуги</th>
                            <th>Сумма</th>
                            <th>Статус заявки</th>
                            <th>Статус договора</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.CreatedAt.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <strong>@item.ClientFullName</strong><br />
                                    <small class="text-muted">@item.ClientPhone</small>
                                </td>
                                <td>
                                    @foreach (var service in item.ServiceNames)
                                    {
                                        <span class="badge bg-secondary">@service</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark">@item.TotalPrice.ToString("N0") ₽</span>
                                </td>
                                <td>
                                    @{
                                        var statusClass = "bg-warning text-dark";
                                        if (item.StatusName.Contains("Отклонен"))
                                            statusClass = "bg-danger";
                                        else if (item.StatusName.Contains("Выполнен") || item.StatusName.Contains("Завершен"))
                                            statusClass = "bg-success";
                                        else if (item.StatusName.Contains("Нов"))
                                            statusClass = "bg-info text-dark";
                                    }
                                    <span class="badge @statusClass">@item.StatusName</span>
                                </td>
                                <td>
                                    @if (item.HasContract)
                                    {
                                        <span class="badge @(item.ContractStatusName.Contains("Подписан") ? "bg-success" : "bg-warning text-dark")">
                                            @item.ContractStatusName
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger small">Нет договора</span>
                                    }
                                </td>
                                <td>
                                    @if (!item.HasContract)
                                    {
                                        <a asp-controller="ContractManager" asp-action="CreateContractFromApp"
                                           asp-route-applicationId="@item.Id"
                                           class="btn btn-sm btn-primary">
                                            📄 Создать договор
                                        </a>
                                    }
                                    else if (item.ContractStatusName.Contains("Подписан"))
                                    {
                                        <a asp-controller="ObjectManager" asp-action="CreateObject"
                                           asp-route-contractId="@item.ContractId"
                                           class="btn btn-sm btn-success">
                                            🏠 Объект
                                        </a>
                                        <a asp-controller="ContractManager" asp-action="Details"
                                           asp-route-id="@item.ContractId"
                                           class="btn btn-sm btn-outline-secondary ms-1">
                                            👁 Договор
                                        </a>
                                    }
                                    else if (item.ContractStatusName == "Расторгнут" || item.ContractStatusName == "Закрыт")
                                    {
                                        <a asp-controller="ContractManager" asp-action="Details"
                                           asp-route-id="@item.ContractId"
                                           class="btn btn-sm btn-outline-secondary">
                                            👁 Детали
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="ContractManager" asp-action="EditContract"
                                           asp-route-id="@item.ContractId"
                                           class="btn btn-sm btn-warning">
                                            ✏️ Договор в работе
                                        </a>
                                    }
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("ObjectManagerApplicationList", "ApplicationManager", new { search = searchTerm, statusId = selectedStatusId, page = currentPage - 1 })">←</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("ObjectManagerApplicationList", "ApplicationManager", new { search = searchTerm, statusId = selectedStatusId, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("ObjectManagerApplicationList", "ApplicationManager", new { search = searchTerm, statusId = selectedStatusId, page = currentPage + 1 })">→</a>
                </li>
            </ul>
        </nav>
        <div class="small text-muted text-end mt-2">
            Показано @((currentPage - 1) * pageSize + 1)–@Math.Min(currentPage * pageSize, totalItems) из @totalItems записей
        </div>
    }
</div>
