@model WebBuild.Models.ObjectManager.ContractServicesViewModel

@{
    ViewData["Title"] = "Услуги договора №" + Model.ContractId;
}

<div class="container mt-4">
    <a asp-controller="ContractManager" asp-action="EditContract" asp-route-id="@Model.ContractId"
       class="btn btn-outline-secondary mb-3">← Назад к договору</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Услуги договора №@Model.ContractId</h4>
            <div>
                <span class="text-muted me-2">Клиент:</span>
                <strong>@Model.ClientName</strong>
                <span class="badge @(Model.ContractStatusName == "Подписан" ? "bg-success" : "bg-warning text-dark") ms-2">
                    @Model.ContractStatusName
                </span>
            </div>
        </div>

        <div class="card-body">
            @if (!Model.CanEdit)
            {
                <div class="alert alert-warning">
                    Договор подписан — редактирование услуг недоступно.
                </div>
            }

            <form asp-controller="ContractManager" asp-action="EditServices" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ContractId" value="@Model.ContractId" />
                <input type="hidden" name="ApplicationId" value="@Model.ApplicationId" />
                <input type="hidden" name="ClientName" value="@Model.ClientName" />
                <input type="hidden" name="ContractStatusName" value="@Model.ContractStatusName" />

                <h5>Текущие услуги</h5>
                <table class="table table-bordered" id="servicesTable">
                    <thead>
                        <tr>
                            <th>Услуга</th>
                            <th style="width: 130px;">Кол-во</th>
                            <th style="width: 150px;">Цена за ед.</th>
                            <th style="width: 140px;">Итого</th>
                            @if (Model.CanEdit)
                            {
                                <th style="width: 80px;">Удалить</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ExistingServices != null && Model.ExistingServices.Any())
                        {
                            for (int i = 0; i < Model.ExistingServices.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <input type="hidden" name="ExistingServices[@i].Id" value="@Model.ExistingServices[i].Id" />
                                        <input type="hidden" name="ExistingServices[@i].ServiceId" value="@Model.ExistingServices[i].ServiceId" />
                                        <input type="hidden" name="ExistingServices[@i].ServiceName" value="@Model.ExistingServices[i].ServiceName" />
                                        <input type="hidden" name="ExistingServices[@i].Unit" value="@Model.ExistingServices[i].Unit" />
                                        <input type="hidden" name="ExistingServices[@i].TotalPrice" value="0" />
                                        @Model.ExistingServices[i].ServiceName
                                        @if (!string.IsNullOrEmpty(Model.ExistingServices[i].Unit))
                                        {
                                            <br /><small class="text-muted">ед. изм: @Model.ExistingServices[i].Unit</small>
                                        }
                                    </td>
                                    <td>
                                        <input type="number" step="1" min="0" name="ExistingServices[@i].Quantity"
                                               value="@Model.ExistingServices[i].Quantity.ToString("0.##")"
                                               class="form-control form-control-sm qty-input"
                                               @(!Model.CanEdit ? "disabled" : "") required />
                                    </td>
                                    <td>
                                        <input type="number" step="0.01" min="0" name="ExistingServices[@i].PricePerUnit"
                                               value="@Model.ExistingServices[i].PricePerUnit.ToString("0.##")"
                                               class="form-control form-control-sm price-input"
                                               @(!Model.CanEdit ? "disabled" : "") required />
                                    </td>
                                    <td class="total-cell fw-bold">
                                        @((Model.ExistingServices[i].Quantity * Model.ExistingServices[i].PricePerUnit).ToString("N2"))
                                    </td>
                                    @if (Model.CanEdit)
                                    {
                                        <td class="text-center">
                                            <input type="checkbox" name="ExistingServices[@i].ShouldDelete" value="true"
                                                   class="form-check-input delete-checkbox" />
                                        </td>
                                    }
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="@(Model.CanEdit ? 5 : 4)" class="text-center text-muted">Услуг нет</td></tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="table-light">
                            <td colspan="3" class="text-end fw-bold">Итого по договору:</td>
                            <td class="fw-bold fs-5" id="grandTotal">0</td>
                            @if (Model.CanEdit)
                            {
                                <td></td>
                            }
                        </tr>
                    </tfoot>
                </table>

                @if (Model.CanEdit)
                {
                    <hr />
                    <h5>Добавить услугу</h5>
                    <div class="row g-2 align-items-end mb-3">
                        <div class="col-md-5">
                            <label class="form-label">Услуга</label>
                            <select name="NewServiceId" class="form-select" id="newServiceSelect">
                                <option value="">-- Выберите услугу --</option>
                                @foreach (var s in Model.AvailableServices)
                                {
                                    <option value="@s.Id" data-price="@s.BasePrice" data-unit="@s.Unit">
                                        @s.Name (@s.Unit) — базовая цена: @s.BasePrice.ToString("N2")
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Кол-во</label>
                            <input type="number" step="1" min="0" name="NewQuantity" id="newQuantity"
                                   class="form-control" placeholder="0" value="1" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label">Цена за ед.</label>
                            <input type="number" step="0.01" min="0" name="NewPricePerUnit" id="newPrice"
                                   class="form-control" placeholder="0" />
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success w-100">
                                💾 Сохранить изменения
                            </button>
                        </div>
                    </div>

                    <div class="alert alert-info small">
                        💡 При выборе услуги цена подставляется автоматически из справочника,
                        но её можно изменить. Количество по умолчанию — 1.
                    </div>
                }
            </form>
        </div>
    </div>
</div>

<script src="~/js/objectManager/contractManager/EditServices.js" asp-append-version="true"></script>

}
