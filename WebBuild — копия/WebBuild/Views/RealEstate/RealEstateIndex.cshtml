@model IEnumerable<WebBuild.Models.Enities.RealEstateObject>
@using WebBuild.Models.Enities
@{
    ViewData["Title"] = "Объекты недвижимости";

    string searchTerm = ViewBag.SearchTerm?.ToString() ?? "";
    long statusId = ViewBag.StatusId != null ? (long)ViewBag.StatusId : 0;
    long managerId = ViewBag.ManagerId != null ? (long)ViewBag.ManagerId : 0;
    string sortBy = ViewBag.SortBy?.ToString() ?? "";
    var statuses = ViewBag.Statuses as List<ObjectStatus> ?? new List<ObjectStatus>();
    var managers = ViewBag.Managers as List<dynamic> ?? new List<dynamic>();
    bool hasFilters = !string.IsNullOrEmpty(searchTerm)
                      || statusId != 0
                      || managerId != 0
                      || !string.IsNullOrEmpty(sortBy);
}

<div class="page-container">
    <div class="header mb-4">
        <h2>Каталог объектов</h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">&lt;&lt; На главную</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="custom-card mb-4">
        <div class="card-header">Фильтр объектов</div>
        <div class="card-body">
            <form method="get" asp-action="RealEstateIndex" asp-controller="RealEstate" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Поиск по адресу / описанию</label>
                    <input type="text" name="search" class="form-control" placeholder="Введите адрес..." value="@searchTerm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Статус</label>
                    <select name="statusId" class="form-select" onchange="this.form.submit()">
                        <option value="0" selected="@(statusId == 0)">Все статусы</option>
                        @foreach (var s in statuses)
                        {
                            <option value="@s.Id" selected="@(s.Id == statusId)">@s.Name</option>
                        }
                    </select>
                </div>
                @if (ViewBag.CanFilterManager != null && (bool)ViewBag.CanFilterManager)
                {
                    <div class="col-md-3">
                        <label class="form-label">Менеджер</label>
                        <select name="managerId" class="form-select" onchange="this.form.submit()">
                            <option value="0" selected="@(managerId == 0)">Все менеджеры</option>
                            @foreach (var m in managers)
                            {
                                <option value="@m.Id" selected="@(m.Id == managerId)">@m.FullName</option>
                            }
                        </select>
                    </div>
                }
                else
                {
                    <input type="hidden" name="managerId" value="0" />
                }
                <div class="col-md-2">
                    <label class="form-label">Сортировка</label>
                    <select name="sortBy" class="form-select" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(sortBy))">Новые сверху</option>
                        <option value="address_asc" selected="@(sortBy == "address_asc")">Адрес (А→Я)</option>
                        <option value="address_desc" selected="@(sortBy == "address_desc")">Адрес (Я→А)</option>
                    </select>
                </div>
                <div class="col-12 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Фильтровать</button>
                    @if (hasFilters)
                    {
                        <a href="@Url.Action("RealEstateIndex", "RealEstate")" class="btn btn-outline-secondary">Сброс</a>
                    }
                </div>
            </form>
        </div>
    </div>

    <form>
        @if (!Model.Any())
        {
            <div class="alert alert-info">Объектов по выбранным фильтрам не найдено.</div>
        }
        else
        {
            <div class="custom-card" style="flex: 1;">
                <div class="card-header mb-3">Объекты</div>
                <div style="overflow-x: auto;">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 40px;"><input type="checkbox" id="selectAll" title="Выбрать все на странице"></th>
                                <th>ID</th>
                                <th>Адрес</th>
                                <th>Статус</th>
                                <th>Менеджер</th>
                                <th>Контракт</th>
                                <th>Описание проекта</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="selectedIds" value="@o.Id" class="app-checkbox" />
                                    </td>
                                    <td><strong>#@o.Id</strong></td>
                                    <td><strong>@o.Address</strong></td>
                                    <td>
                                        @if (o.CurrentStatus != null)
                                        {
                                            <span class="badge bg-info text-dark">@o.CurrentStatus.Name</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        @if (o.Manager != null)
                                        {
                                            <span class="badge bg-primary">@(o.Manager.PersonData?.Surname) @(o.Manager.PersonData?.Name)</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger small">Не назначен</span>
                                        }
                                    </td>
                                    <td>
                                        @if (o.ContractId.HasValue)
                                        {
                                            <span class="badge bg-success">Договор #@o.ContractId</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Нет</span>
                                        }
                                    </td>
                                    <td class="text-truncate" style="max-width: 200px;" title="@o.ProjectDescription">
                                        @(o.ProjectDescription ?? "-")
                                    </td>
                                    <td>
                                        <a asp-controller="RealEstate" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-info">Подробнее</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </form>
</div>

<script src="~/js/admin/realEstate/RealEstateIndex.js" asp-append-version="true"></script>
