@{
    ViewData["Title"] = "Список заявок";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
<a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary mb-3">&lt;&lt; На главную админки</a>
<h2 class="mb-4">Список заявок</h2>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>ID</th>
            <th>Клиент</th>
            <th>Телефон</th>
            <th>Email</th>
            <th>Услуга / Кол-во</th>
            <th>Сумма</th>
            <th>Статус</th>
            <th>Текущий руководитель</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model)
        {
            <tr>
                <td>@app.Id</td>
                <td>
                    <strong>@app.ClientName</strong><br>
                    <small class="text-muted">@app.CompanyName</small>
                </td>
                <td>@app.Phone</td>
                <td>@app.Email</td>
                <td>@app.ServiceName<br><small>@app.Quantity шт.</small></td>
                <td>@app.TotalPrice.ToString("N0") ₽</td>
                <td><span class="badge bg-warning text-dark">@app.CurrentStatusName</span></td>

                <td>
                    @if (!string.IsNullOrEmpty(app.AssignedManagerName))
                    {
                        <span class="badge bg-primary">@app.AssignedManagerName</span>
                    }
                    else
                    {
                        <span class="text-danger">Не назначен</span>
                    }
                </td>

                <td>
                    <a asp-controller="Application"
                       asp-action="AssignManagerForm"
                       asp-route-id="@app.Id"
                       class="btn btn-sm btn-primary">
                         Назначить / Редактировать
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
