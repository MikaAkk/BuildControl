@model WebBuild.Models.Admin.EmployeeCreateEditViewModel;

@{
    ViewData["Title"] = "Добавить нового сотрудника";
    var positionsData = ViewBag.Positions as System.Collections.IEnumerable;
    var rolesData = ViewBag.Roles as System.Collections.IEnumerable;
    var statesData = ViewBag.States as System.Collections.IEnumerable;
    bool hasPositions = positionsData != null && positionsData.Cast<object>().Any();
    bool hasRoles = rolesData != null && rolesData.Cast<object>().Any();
    bool hasStates = statesData != null && statesData.Cast<object>().Any();
}

<h2 class="mb-4">Добавить нового сотрудника</h2>

<a asp-action="Index" asp-controller="EditCreate" class="btn btn-secondary mb-3">&lt;&lt; Вернуться к списку</a>

<form asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    @if (!hasPositions)
    {
        <div class="alert alert-danger">Ошибка: В базе данных нет должностей! Нельзя создать сотрудника.</div>
    }

    <div class="row">
        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Surname" class="form-label">Фамилия</label>
                <input asp-for="Surname" class="form-control" />
                <span asp-validation-for="Surname" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Name" class="form-label">Имя</label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Patronymic" class="form-label">Отчество</label>
                <input asp-for="Patronymic" class="form-control" />
            </div>
        </div>

        <div class="col-md-6">
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email (Логин)</label>
                <input asp-for="Email" type="email" class="form-control" placeholder="example@mail.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Пароль</label>
                <input asp-for="Password" type="password" class="form-control" autocomplete="new-password" />
                <small class="text-muted">Пароль будет надежно захеширован.</small>
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>
        </div>
    </div>

    <hr class="my-4">
    <div class="row">
        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="PositionId" class="form-label">Должность</label>
                @{
                    var positions = hasPositions
                        ? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(positionsData, "Id", "Name")
                        : new Microsoft.AspNetCore.Mvc.Rendering.SelectList(new System.Collections.Generic.List<object>(), "Id", "Name");
                }
                <select asp-for="PositionId" asp-items="positions" class="form-select" required>
                    <option value="">-- Выберите должность --</option>
                </select>
                <span asp-validation-for="PositionId" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="RoleId" class="form-label">Роль</label>
                @{
                    var roles = hasRoles
                        ? new Microsoft.AspNetCore.Mvc.Rendering.SelectList(rolesData, "Id", "Name")
                        : new Microsoft.AspNetCore.Mvc.Rendering.SelectList(new System.Collections.Generic.List<object>(), "Id", "Name");
                }
                <select asp-for="RoleId" asp-items="roles" class="form-select" required>
                    <option value="">-- Выберите роль --</option>
                </select>
                <span asp-validation-for="RoleId" class="text-danger"></span>
            </div>
        </div>

        <div class="col-md-4">
            <div class="mb-3">
                <label asp-for="PhoneNumberInput" class="form-label">Номер телефона</label>
                <input asp-for="PhoneNumberInput" type="tel" class="form-control"
                       placeholder="+7 (999) 000-00-00"
                       pattern="[\d\+\-\(\)\s]{7,20}"
                       title="Введите корректный номер телефона">
                <div class="form-text">Можно ввести новый номер или существующий.</div>
            </div>
        </div>
    </div>
    <div class="row mt-3">
        <div class="col-md-4 offset-md-8">
            <div class="mb-3">
                <label asp-for="EmployeeStateId" class="form-label">Состояние сотрудника</label>

                @{
                    var rawData = ViewBag.States ?? new System.Collections.Generic.List<object>();
                    var enumerableData = rawData as System.Collections.IEnumerable ?? new System.Collections.Generic.List<object>();
                    var statesSelectList = new Microsoft.AspNetCore.Mvc.Rendering.SelectList(enumerableData, "Id", "State");
                    bool isEmpty = !enumerableData.Cast<object>().Any();
                }

                <select asp-for="EmployeeStateId" asp-items="statesSelectList" class="form-select" required>
                    <option value="">-- Выберите состояние --</option>
                </select>
                <span asp-validation-for="EmployeeStateId" class="text-danger"></span>

                @if (isEmpty)
                {
                    <div class="alert alert-warning mt-2 small p-2">
                        В базе нет записей состояний сотрудников. Добавьте хотя бы одну запись в таблицу employee_stat.
                    </div>
                }
            </div>
        </div>
    </div>


    <hr class="my-4">

    <button type="submit" class="btn btn-success">Сохранить сотрудника</button>
    <a asp-action="Index" asp-controller="EditCreate" class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
