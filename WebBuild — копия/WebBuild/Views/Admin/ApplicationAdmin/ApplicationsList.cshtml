@model IEnumerable<WebBuild.Models.Admin.ApplicationViewModel>
@{
    ViewData["Title"] = "Список заявок";
    int currentPage = ViewBag.CurrentPage != null ? (int)ViewBag.CurrentPage : 1;
    int totalPages = ViewBag.TotalPages != null ? (int)ViewBag.TotalPages : 1;
    int pageSize = ViewBag.PageSize != null ? (int)ViewBag.PageSize : 20;
    int totalItems = ViewBag.TotalItems != null ? (int)ViewBag.TotalItems : 0;
    string searchTerm = ViewBag.SearchTerm?.ToString() ?? "";
    long selectedStatusId = ViewBag.SelectedStatusId != null ? (long)ViewBag.SelectedStatusId : 0;
    long selectedManagerId = ViewBag.SelectedManagerId != null ? (long)ViewBag.SelectedManagerId : 0;
}
<div class="page-container">
    <div class="header mb-4">
        <h2>Список заявок</h2>
        <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary">&lt;&lt; На главную админки</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="custom-card mb-4">
        <div class="card-header">Фильтр</div>
        <div class="card-body">
            <form method="get" asp-action="ApplicationsList" asp-controller="Application" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Поиск (ФИО, телефон, ID)</label>
                    <input type="text" name="search" class="form-control" placeholder="Иванов, +7999..." value="@searchTerm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">Статус</label>
                    <select name="statusId" class="form-select">
                        <option value="0" selected="@(selectedStatusId == 0)">-- Все статусы --</option>
                        @foreach (var s in (IEnumerable<WebBuild.Models.Enities.ApplicationStatus>)ViewBag.Statuses)
                        {
                            <option value="@s.Id" selected="@(s.Id == selectedStatusId)">@s.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Руководитель</label>
                    <select name="managerId" class="form-select">
                        <option value="0" selected="@(selectedManagerId == 0)">-- Все --</option>
                        @foreach (var m in (IEnumerable<WebBuild.Models.Enities.Employee>)ViewBag.Managers)
                        {
                            <option value="@m.Id" selected="@(m.Id == selectedManagerId)">@m.PersonData.Surname @m.PersonData.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3 d-flex align-items-end gap-2 mt-2">
                    <button type="submit" class="btn btn-primary">Фильтровать</button>
                    <a href="@Url.Action("ApplicationsList", "Application")" class="btn btn-outline-secondary">Сброс</a>
                </div>
            </form>
        </div>
    </div>


    <form asp-action="BulkAssignManager" asp-controller="Application" method="post" id="bulkForm" class="d-flex flex-column gap-3" style="display: flex; flex-direction: column;">
        @Html.AntiForgeryToken()
        <div class="d-flex gap-2 align-items-center" style="flex-wrap: wrap;">
            <select name="managerId" class="form-select" style="max-width: 250px;">
                <option value="">-- Выберите менеджера для всех --</option>
                @foreach (var m in (IEnumerable<WebBuild.Models.Enities.Employee>)ViewBag.Managers)
                {
                    <option value="@m.Id">@m.PersonData.Surname @m.PersonData.Name</option>
                }
            </select>
            <button type="submit" class="btn btn-success" disabled id="bulkBtn">Назначить всем</button>
        </div>
        @if (!Model.Any())
        {
            <div class="alert alert-info">Заявок не найдено.</div>
        }
        else
        {
            <div class="custom-card" style="flex: 1;">
                <div class="card-header mb-3">Заявки</div>
                <div style="overflow-x: auto;">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th style="width: 40px;"><input type="checkbox" id="selectAll" title="Выбрать все на странице"></th>
                                <th>ID</th>
                                <th>Клиент</th>
                                <th>Телефон</th>
                                <th>Услуга / Сумма</th>
                                <th>Статус</th>
                                <th>Руководитель</th>
                                <th>Действия</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var app in Model)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox" name="selectedIds" value="@app.Id" class="app-checkbox" />
                                    </td>
                                    <td><strong>#@app.Id</strong></td>
                                    <td>
                                        <strong>@app.ClientName</strong><br />
                                        <small class="text-muted">@app.CompanyName</small>
                                    </td>
                                    <td>@app.Phone</td>
                                    <td>
                                        @app.ServiceName<br />
                                        <span class="badge bg-light text-dark">@app.TotalPrice.ToString("N0") ₽</span>
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = "bg-warning text-dark";
                                            if (app.CurrentStatusName == "Отклонена")
                                                statusClass = "bg-danger";
                                            else if (app.CurrentStatusName == "Выполнена")
                                                statusClass = "bg-success";
                                            else if (app.CurrentStatusName == "Новая")
                                                statusClass = "bg-info text-dark";
                                        }
                                        <span class="badge @statusClass">@app.CurrentStatusName</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(app.AssignedManagerName) && app.AssignedManagerName != "Не назначен")
                                        {
                                            <span class="badge bg-primary">@app.AssignedManagerName</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger small">Не назначен</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="Application" asp-action="AssignManagerForm" asp-route-id="@app.Id" class="btn btn-sm btn-primary">Редактировать</a>
                                        <a asp-controller="Application" asp-action="Details" asp-route-id="@app.Id" class="btn btn-sm btn-info">Детали</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </form>
    @if (totalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("ApplicationsList", "Application", new { search = searchTerm, statusId = selectedStatusId, managerId = selectedManagerId, page = currentPage - 1 })">←</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action("ApplicationsList", "Application", new { search = searchTerm, statusId = selectedStatusId, managerId = selectedManagerId, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action("ApplicationsList", "Application", new { search = searchTerm, statusId = selectedStatusId, managerId = selectedManagerId, page = currentPage + 1 })">→</a>
                </li>
            </ul>
        </nav>
        <div class="small text-muted text-end mt-2">
            Показано @((currentPage - 1) * pageSize + 1)–@Math.Min(currentPage * pageSize, totalItems) из @totalItems записей
        </div>
    }
</div>

<script src="~/js/admin/applicationAdmin/ApplicationsList.js" asp-append-version="true"></script>