@{
    ViewData["Title"] = "Админ-панель";
}

<div class="container mt-4">
    <h1>Добро пожаловать, Администратор!</h1>
    <p>Здесь ты можешь управлять всеми данными системы.</p>

    <div class="alert alert-success">
        <strong>Статус доступа:</strong> Полный доступ ко всем модулям.
    </div>

    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <a asp-controller="EditCreate" asp-action="Index" class="card text-white bg-primary h-100 text-decoration-none d-flex flex-column align-items-center justify-content-center p-4 shadow">
                <h3>Сотрудники</h3>
            </a>
        </div>
    </div>
    <div class="row mt-4">
        <div class="col-md-4 mb-3">
            <a asp-controller="Application" asp-action="ApplicationsList" class="card text-white bg-primary h-100 text-decoration-none d-flex flex-column align-items-center justify-content-center p-4 shadow">
                <h3>Заявки</h3>
            </a>
        </div>
    </div>
    <hr class="my-4">

    <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
        <button type="submit" class="btn btn-danger">Выйти из системы</button>
    </form>
</div>
