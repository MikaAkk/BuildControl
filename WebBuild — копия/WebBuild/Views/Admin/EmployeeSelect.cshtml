@model IEnumerable<WebBuild.Models.Enities.Employee>

@{
    ViewData["Title"] = "Список сотрудников";
}

<div class="container mt-4">
    <h2 class="mb-3">Список сотрудников</h2>
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary mb-3">&lt;&lt; На главную админки</a>
    <a asp-action="Create" asp-controller="EditCreate" class="btn btn-primary mb-3">+ Добавить сотрудника</a>
    <hr />

    @if (!Model.Any())
    {
        <div class="alert alert-info">Список пуст. Добавьте первого сотрудника.</div>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ФИО</th>
                    <th>Должность</th>
                    <th>Роль</th>
                    <th>Телефон</th>
                    <th>Статус</th>
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var emp in Model)
                {
                    <tr>
                        <td>
                            @(emp.PersonData != null
                                ? $"{emp.PersonData.Surname} {emp.PersonData.Name} {emp.PersonData.Patronymic}"
                                : "Нет данных")
                        </td>
                        <td>@(emp.Position?.Name ?? "Не назначена")</td>
                        <td>@(emp.Role?.Name ?? "Нет роли")</td>
                        <td>@(emp.PersonData?.PhoneNumber?.Phone ?? "Нет телефона")</td>
                        <td>@(emp.EmployeeStat?.State ?? "Неизвестно")</td>
                        <td class="d-flex gap-2">
                            <a asp-action="Edit" asp-route-id="@emp.Id" class="btn btn-sm btn-warning text-dark">Изменить</a>
                            <form asp-action="Delete" asp-route-id="@emp.Id" method="post"
                                  style="display:inline;"
                                  onsubmit="return confirm(`Вы уверены, что хотите удалить сотрудника ${'@emp.PersonData.Surname'}?`);">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-danger">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    }
</div>
