@model IEnumerable<WebBuild.Models.Enities.WorkerService>
@{
    ViewData["Title"] = "Прайс-лист услуг";

    string searchTerm = ViewBag.SearchTerm ?? "";
    string statusFilter = ViewBag.StatusFilter ?? "active";
    string sortBy = ViewBag.SortBy ?? "";
    bool hasFilters = !string.IsNullOrEmpty(searchTerm) || statusFilter != "active" || !string.IsNullOrEmpty(sortBy);
}

<div class="container-fluid">
    <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary mb-3">&lt;&lt; Назад в админку</a>
    <h2 class="mb-4">Услуги и работы</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <strong>Фильтр услуг</strong>
        </div>
        <div class="card-body p-3">
            <form asp-action="ServiceIndex" method="get" class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label">Поиск по названию / описанию</label>
                    <input type="text" name="search" class="form-control"
                           placeholder="Введите название..." value="@searchTerm" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">Статус</label>
                    <select name="status" class="form-select" onchange="this.form.submit()">
                        <option value="active" selected="@(statusFilter == "active")">Только активные</option>
                        <option value="inactive" selected="@(statusFilter == "inactive")">Только неактивные</option>
                        <option value="all" selected="@(statusFilter == "all")">Все услуги</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Сортировка</label>
                    <select name="sortBy" class="form-select" onchange="this.form.submit()">
                        <option value="" selected="@(string.IsNullOrEmpty(sortBy))">Новые сверху</option>
                        <option value="price_asc" selected="@(sortBy == "price_asc")">Цена ↑</option>
                        <option value="price_desc" selected="@(sortBy == "price_desc")">Цена ↓</option>
                        <option value="name_asc" selected="@(sortBy == "name_asc")">Название (А→Я)</option>
                    </select>
                </div>

                <div class="col-md-1 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">Найти</button>
                </div>
            </form>

            @if (hasFilters)
            {
                <div class="mt-2">
                    <a asp-action="ServiceIndex" class="btn btn-sm btn-outline-secondary">Сбросить фильтры</a>
                </div>
            }
        </div>
    </div>

    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">+ Добавить услугу</a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">Услуг по выбранным фильтрам не найдено.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover table-sm w-100">
                <thead class="table-dark">
                    <tr>
                        <th>Название</th>
                        <th>Ед. изм.</th>
                        <th>Базовая цена</th>
                        <th>Описание</th>
                        <th width="100">Статус</th>
                        <th width="200">Действия</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><strong>@s.Name</strong></td>
                            <td>@(s.Unit ?? "-")</td>
                            <td class="fw-bold">@s.BasePrice.ToString("N2") ₽</td>
                            <td class="text-truncate" style="max-width: 250px;" title="@s.Description">
                                @(s.Description ?? "-")
                            </td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge bg-success">Активна</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Неактивна</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-warning text-dark">Изменить</a>

                                <form asp-action="ToggleActive" method="post" class="d-inline"
                                      onsubmit="return confirm('Вы действительно хотите @(s.IsActive ? "отключить" : "включить") услугу «@s.Name»?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@s.Id" />
                                    <button type="submit"
                                            class="btn btn-sm @(s.IsActive ? "btn-outline-danger" : "btn-outline-success")">
                                        @(s.IsActive ? "Отключить" : "Включить")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div> 