@model WebBuild.Models.Admin.ClientEditViewModel

@{
    ViewData["Title"] = "Редактирование клиента";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="container mt-4">
    <h2 class="mb-4">Редактирование клиента #@Model.Id</h2>

    <a asp-action="ClientIndex" asp-controller="Client" class="btn btn-secondary mb-3">&lt;&lt; К списку клиентов</a>

    <form asp-action="Edit" asp-controller="Client" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Surname" class="form-label">Фамилия</label>
                    <input asp-for="Surname" class="form-control" />
                    <span asp-validation-for="Surname" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Имя</label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Patronymic" class="form-label">Отчество</label>
                    <input asp-for="Patronymic" class="form-control" />
                </div>
            </div>

            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PhoneNumberInput" class="form-label">Телефон</label>
                    <input asp-for="PhoneNumberInput" type="tel" class="form-control"
                           placeholder="+7 (999) 000-00-00" />
                </div>
            </div>
        </div>

        <hr class="my-4">

        <h5>Данные компании (необязательно)</h5>
        <div class="row">
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="CompanyName" class="form-label">Название компании</label>
                    <input asp-for="CompanyName" class="form-control"
                           placeholder="Оставьте пустым, если частное лицо" />
                    <div class="form-text">Если поле пустое — клиент считается частным лицом.</div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="mb-3">
                    <label asp-for="CompanyAddress" class="form-label">Адрес компании</label>
                    <input asp-for="CompanyAddress" class="form-control" />
                </div>
            </div>
        </div>

        <hr class="my-4">

        <button type="submit" class="btn btn-success">Сохранить изменения</button>
        <a asp-action="ClientIndex" asp-controller="Client" class="btn btn-secondary">Отмена</a>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
