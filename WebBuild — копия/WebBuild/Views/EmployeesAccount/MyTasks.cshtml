@model WebBuild.Models.EmployeesModel.EmployeeTasksPageViewModel
@using WebBuild.Models.Enities
@{
    ViewData["Title"] = "Мои задачи";
    var tasks = Model.Tasks;
    var availableStatuses = Model.AvailableStatuses;
}
<link href="/css/style.css" rel="stylesheet" />

<div class="page-container">
    <div class="page-header mb-4 d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Мои задачи</h2>
        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-logout">
                <svg class="bi" width="16" height="16">
                    <use xlink:href="/bootstrap-icons.svg#box-arrow-right"></use>
                </svg>
                Выйти
            </button>
        </form>
    </div>

    <p class="text-muted mb-4">Здесь вы можете видеть все свои задачи и отмечать их выполнение.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
    }
    else if (tasks == null || !tasks.Any())
    {
        <div class="alert alert-info">У вас нет назначенных задач.</div>
    }
    else
    {
        <div class="row mb-4 g-3 justify-content-center">
            <div class="col-md-3">
                <div class="card stat-card stat-blue h-100 d-flex">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="stat-title">Всего задач</h5>
                            <p class="stat-number mb-0">@tasks.Count</p>
                        </div>
                        <small class="stat-desc">Все назначенные вам задачи</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card stat-card stat-amber h-100 d-flex">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="stat-title">В работе</h5>
                            <p class="stat-number mb-0">@(tasks.Count(t => t.StatusName == "В работе"))</p>
                        </div>
                        <small class="stat-desc">Активные задачи, требующие внимания</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card stat-card stat-cyan h-100 d-flex">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="stat-title">Выполнено</h5>
                            <p class="stat-number mb-0">@(tasks.Count(t => t.StatusName == "Готово"))</p>
                        </div>
                        <small class="stat-desc">Завершённые задачи</small>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card stat-card stat-red h-100 d-flex position-relative overflow-hidden">
                    <div class="card-body d-flex flex-column justify-content-between position-relative">
                        <div>
                            <h5 class="stat-title">Просрочено</h5>
                            @if (tasks.Any(t => t.IsOverdue))
                            {
                                <p class="stat-number mb-0 text-danger">@(tasks.Count(t => t.IsOverdue))</p>
                                <small class="stat-desc text-danger">Требуют срочного решения</small>
                            }
                            else
                            {
                                <p class="stat-number mb-0 text-success">0</p>
                                <small class="stat-desc text-success">Всё в порядке!</small>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="custom-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h4 class="mb-0">📋 Список задач</h4>
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">← На главную</a>
            </div>
            <div class="card-body" style="padding: 0;">
                <div style="overflow-x: auto;">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>Объект</th>
                                <th>Описание задачи</th>
                                <th>Срок</th>
                                <th>Текущий статус</th>
                                <th style="width: 220px;">Действие</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in tasks)
                            {
                                <tr>
                                    <td class="fw-bold text-truncate" style="max-width: 200px;">@task.ObjectAddress</td>
                                    <td class="text-truncate" style="max-width: 300px;">@task.Description</td>
                                    <td>
                                        @if (task.PlannedEndDate.HasValue)
                                        {
                                            <span class="badge @task.BadgeClass">@task.DaysLeftText</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Без срока</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var statusBadge = task.StatusName switch
                                            {
                                                "Готово" => "bg-success",
                                                "В работе" => "bg-primary",
                                                "Требует проверки" => "bg-warning text-dark",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusBadge">@task.StatusName</span>
                                    </td>
                                    <td>
                                        <form asp-action="UpdateTaskStatus" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="taskId" value="@task.Id" />
                                            <select name="newStatusId" class="form-select form-select-sm d-inline-block w-auto" onchange="this.form.submit()">
                                                @foreach (var status in availableStatuses)
                                                {
                                                    <option value="@status.Id" selected="@(status.Id == task.StatusId)">
                                                        @status.Name
                                                    </option>
                                                }
                                            </select>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
