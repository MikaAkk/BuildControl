@using WebBuild.Models.Enities
@{
    ViewData["Title"] = "Кабинет сотрудника";
}
<link href="/css/style.css" rel="stylesheet" />

<div class="page-container">
    <div class="page-header mb-4 d-flex justify-content-between align-items-center">
        <h2 class="mb-0">Кабинет сотрудника</h2>
        <form asp-controller="Account" asp-action="Logout" method="post" style="display:inline;">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-logout">
                <svg class="bi" width="16" height="16">
                    <use xlink:href="/bootstrap-icons.svg#box-arrow-right"></use>
                </svg>
                Выйти
            </button>
        </form>
    </div>

    <p class="text-muted mb-4">Ваши задачи и объекты, на которые вы назначены.</p>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-circle-fill"></i>
            @ViewBag.Error
        </div>
    }
    else
    {
        <div class="row mb-4 g-3 justify-content-center">
            <div class="col-md-3">
                <div class="card stat-card stat-blue h-100 d-flex">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="stat-title">Всего объектов</h5>
                            <p class="stat-number mb-0">@(ViewBag.TotalObjects ?? 0)</p>
                        </div>
                        <small class="stat-desc">Объекты, где вы назначены исполнителем</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card stat-amber h-100 d-flex">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="stat-title">Задач в работе</h5>
                            <p class="stat-number mb-0">@(ViewBag.InProgressTasks ?? 0)</p>
                        </div>
                        <small class="stat-desc">Активные задачи, требующие вашего внимания</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card stat-cyan h-100 d-flex">
                    <div class="card-body d-flex flex-column justify-content-between">
                        <div>
                            <h5 class="stat-title">Выполнено</h5>
                            <p class="stat-number mb-0">@(ViewBag.DoneTasks ?? 0)</p>
                        </div>
                        <small class="stat-desc">Завершенные задачи за отчетный период</small>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card stat-card stat-red h-100 d-flex position-relative overflow-hidden">
                    <div class="card-body d-flex flex-column justify-content-between position-relative">
                        <div>
                            <h5 class="stat-title">Просроченные задачи</h5>
                            @if ((int?)ViewBag.OverdueTasks > 0)
                            {
                                <p class="stat-number mb-0 text-danger">@ViewBag.OverdueTasks</p>
                                <small class="stat-desc text-danger">Требуют немедленного решения</small>
                            }
                            else
                            {
                                <p class="stat-number mb-0 text-success">@ViewBag.OverdueTasks</p>
                                <small class="stat-desc text-success">Всё в порядке!</small>
                            }
                        </div>
                        @if ((int?)ViewBag.OverdueTasks > 0)
                        {
                            <button type="button" data-bs-toggle="modal" data-bs-target="#overdueModal"
                                    class="btn btn-sm btn-outline-danger rounded-pill shadow-sm">
                                Проверить список
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
        @if ((int?)ViewBag.OverdueTasks > 0)
        {
            <div class="alert alert-warning d-flex align-items-center gap-2 mb-4 rounded-0 border-0">
                <i class="bi bi-clock-history text-warning"></i>
                <div>
                    У вас <strong class="text-danger">@ViewBag.OverdueTasks просроченных задач</strong>. Срочно проверьте сроки и обновите статусы.
                </div>
            </div>
        }
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="card h-100 d-flex flex-column">
                    <div class="card-header">
                        <h4>Ближайшие задачи</h4>
                    </div>
                    <div class="card-body flex-fill d-flex flex-column">
                        @if (ViewBag.UpcomingTasks != null && ((System.Collections.IEnumerable)ViewBag.UpcomingTasks).Cast<object>().Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="bg-light">
                                        <tr>
                                            <th class="ps-4">Объект</th>
                                            <th>Задача</th>
                                            <th style="min-width: 120px;">Срок</th>
                                            <th style="min-width: 100px;">Статус</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var task in ViewBag.UpcomingTasks as System.Collections.Generic.IEnumerable<WebBuild.Models.EmployeesModel.TaskSummaryViewModel>)
                                        {
                                            <tr>
                                                <td class="ps-4 fw-medium text-truncate" style="max-width: 220px;">
                                                    @task.ObjectAddress
                                                </td>
                                                <td class="text-truncate" style="max-width: 300px;">
                                                    @task.Description
                                                </td>
                                                <td>
                                                    @if (task.PlannedEndDate.HasValue)
                                                    {
                                                        <span class="badge @task.BadgeClass px-2 py-1 fw-normal fs-6">
                                                            @task.DaysLeftBadge
                                                        </span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted small">Без срока</span>
                                                    }
                                                </td>
                                                <td>
                                                    <span class="badge bg-secondary px-2 py-1 fw-normal text-uppercase fs-7">
                                                        @task.StatusName
                                                    </span>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-inbox fs-4 mb-3"></i>
                                <p>На данный момент нет ближайших задач.</p>
                            </div>
                        }

                        <div class="mt-auto pt-3 border-top">
                            <a asp-action="MyTasks" class="btn btn-action w-100">
                                📋 Перейти к полному списку задач
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<div class="modal fade" id="overdueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">🔥 Просроченные задачи (@ViewBag.OverdueTasks)</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @if (ViewBag.TopOverdueTasks != null && ((System.Collections.IEnumerable)ViewBag.TopOverdueTasks).Cast<object>().Any())
                {
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Объект</th>
                                <th>Задача</th>
                                <th>Срок</th>
                                <th>Исполнитель</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var task in (IEnumerable<dynamic>)ViewBag.TopOverdueTasks)
                            {
                                int daysOverdue = (DateTime.UtcNow - task.DueDate).Days;
                                <tr>
                                    <td class="fw-bold">@task.ObjectAddress</td>
                                    <td>@task.TaskDescription</td>
                                    <td>
                                        <span class="badge bg-danger">
                                            -@daysOverdue дн.
                                        </span>
                                    </td>
                                    <td>@task.EmployeeName</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">На данный момент нет просроченных задач.</p>
                }
            </div>
        </div>
    </div>
</div>
