@model WebBuild.Models.ObjectManager.ContractEditViewModel

@{
    ViewData["Title"] = "Договор №" + Model.Id;
}

<div class="container mt-4">
    <a asp-controller="ApplicationManager" asp-action="ObjectManagerApplicationList"
       class="btn btn-outline-secondary mb-3">← К списку заявок</a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow">
        <div class="card-header">
            <h4 class="mb-0">Договор №@Model.Id</h4>
        </div>
        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <p><strong>Клиент:</strong> @Model.ClientName</p>
                    <p><strong>Email:</strong> @Model.ClientEmail</p>
                    <p><strong>Шаблон:</strong> @Model.TemplateName</p>
                </div>
                <div class="col-md-6">
                    <p>
                        <strong>Статус:</strong>
                        @{
                            var badge = Model.IsSigned ? "bg-success" : "bg-warning text-dark";
                        }
                        <span class="badge @badge fs-6">@Model.StatusName</span>
                    </p>
                    <p><strong>Подписал:</strong> @Model.SignerName</p>
                </div>
            </div>

            <form asp-controller="ContractManager" asp-action="EditContract" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Дата начала</label>
                        <input type="date" name="StartDate"
                               value="@Model.StartDate.ToString("yyyy-MM-dd")"
                               class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Дата окончания</label>
                        <input type="date" name="EndDate"
                               value="@Model.EndDate.ToString("yyyy-MM-dd")"
                               class="form-control" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label for="SelectedStatusId" class="form-label">Статус договора</label>
                    <select asp-for="SelectedStatusId"
                            asp-items="Model.Statuses"
                            class="form-select"
                            id="SelectedStatusId"
                            required>
                        <option value="">Выберите статус</option>
                    </select>
                </div>

                @if (!Model.IsSigned)
                {
                    <div class="form-check mb-3">
                        <input type="checkbox" name="ShouldSign" value="true" class="form-check-input" id="shouldSign" />
                        <label class="form-check-label" for="shouldSign">
                            Подписать договор
                        </label>
                    </div>
                }

                <div class="d-flex gap-2 flex-wrap">
                    <button type="submit" class="btn btn-primary">Сохранить</button>
                    <a asp-controller="ContractManager" asp-action="Details" asp-route-id="@Model.Id"
                       class="btn btn-outline-secondary">Детали</a>
                    @if (!Model.IsSigned)
                    {
                        <a asp-controller="ContractManager" asp-action="EditServices" asp-route-id="@Model.Id"
                           class="btn btn-outline-primary">📋 Управление услугами</a>
                    }
                </div>
            </form>
            @if (Model.IsSigned)
            {
                <hr />
                <div class="alert alert-success d-flex align-items-center justify-content-between">
                    <div>
                        <strong>Договор подписан.</strong> Теперь можно перейти к объекту строительства.
                    </div>
                    <a asp-controller="ObjectManager" asp-action="CreateObject"
                       asp-route-contractId="@Model.Id"
                       class="btn btn-success">🏠 Объект</a>
                </div>
            }
        </div>
    </div>
</div>
