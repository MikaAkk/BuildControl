@model WebBuild.Models.ObjectManager.EditTaskViewModel

@{
    ViewData["Title"] = "Редактировать задачу";
}

<div class="container mt-4">
    <a asp-controller="ObjectManager" asp-action="ObjectDetails" asp-route-id="@Model.ObjectId"
       class="btn btn-outline-secondary mb-3">← Назад к объекту</a>

    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">✏️ Редактирование задачи</h4>
        </div>
        <div class="card-body">
            <p class="text-muted">Объект: <strong>@Model.ObjectAddress</strong></p>

            <form asp-controller="TaskManager" asp-action="EditTask" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Id" value="@Model.Id" />
                <input type="hidden" name="ObjectId" value="@Model.ObjectId" />
                <input type="hidden" name="ObjectAddress" value="@Model.ObjectAddress" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Исполнитель <span class="text-danger">*</span></label>
                        <select name="EmployeeId" class="form-select" required>
                            @foreach (var emp in Model.AvailableEmployees)
                            {
                                <option value="@emp.Id" selected="@(Model.EmployeeId == emp.Id)">
                                    @emp.FullName (@emp.Position)
                                </option>
                            }
                        </select>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Статус задачи</label>
                        <select name="StatusId" class="form-select">
                            @foreach (var s in Model.AvailableStatuses)
                            {
                                <option value="@s.Id" selected="@(Model.StatusId == s.Id)">@s.Name</option>
                            }
                        </select>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label">Название задачи <span class="text-danger">*</span></label>
                    <input type="text" name="Title" value="@Model.Title" class="form-control" required />
                </div>

                <div class="mt-3">
                    <label class="form-label">Описание</label>
                    <textarea name="Description" class="form-control" rows="3">@Model.Description</textarea>
                </div>

                <div class="row mt-3">
                    <div class="col-md-6">
                        <label class="form-label">Плановая дата начала</label>
                        <input type="date" name="PlannedStartDate" class="form-control"
                               value="@Model.PlannedStartDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Плановая дата окончания <span class="text-danger">*</span></label>
                        <input type="date" name="PlannedEndDate" class="form-control" required
                               value="@Model.PlannedEndDate?.ToString("yyyy-MM-dd")" />
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-success">💾 Сохранить</button>
                    <a asp-controller="ObjectManager" asp-action="ObjectDetails" asp-route-id="@Model.ObjectId"
                       class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>
